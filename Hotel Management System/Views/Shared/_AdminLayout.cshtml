<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <aside class="sidebar">
            <div class="sidebar-brand">
                🏨 HMS Desktop
            </div>
            <ul class="sidebar-menu">
                <li class="sidebar-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a href="/Admin/Dashboard">📊 Dashboard</a>
                </li>
                <li class="sidebar-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                    <a href="/Admin/Settings">⚙️ System Settings</a>
                </li>
                <li class="sidebar-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageItems" ? "active" : "")">
                    <a href="/Admin/ManageItems">🍔 Menu Items</a>
                </li>
                <li class="sidebar-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageWaiters" ? "active" : "")"><a href="/Admin/ManageWaiters">🏃 Manage Waiters</a></li>
                <li class="sidebar-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"><a href="/Kitchen/Index">🍳 Kitchen Queue</a></li>
            </ul>
            <div class="mt-auto">
                <a href="/Account/Logout" class="btn btn-outline-danger w-100">Logout</a>
            </div>
        </aside>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>