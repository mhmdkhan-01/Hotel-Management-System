@model Hotel_Management_System.Controllers.LoginViewModel
@{
    Layout = null; // Standalone simple presentation panel
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Gateway - System Access</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                background-color: var(--light-bg);
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
            }

            .login-card {
                background: var(--white);
                border-radius: 16px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
                padding: 40px;
                max-width: 400px;
                width: 100%;
                border-top: 6px solid var(--primary-pink);
            }

            .login-title {
                font-weight: 700;
                color: var(--dark-neutral);
                text-align: center;
                margin-bottom: 25px;
            }

            .form-control:focus {
                border-color: var(--accent-pink);
                box-shadow: 0 0 0 0.2rem rgba(255, 146, 164, 0.25);
            }
    </style>
</head>
<body>

    <div class="login-card">
        <h3 class="login-title">🏨 Staff Portal</h3>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="form-group mb-3">
                <label class="form-label text-secondary small font-weight-bold">EMAIL ADDRESS</label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="name@hotel.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label class="form-label text-secondary small font-weight-bold">PASSWORD</label>
                <input asp-for="Password" class="form-control form-control-lg" type="password" placeholder="••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-pink w-100 btn-lg py-2">Sign In</button>
        </form>

        <div class="text-center mt-3">
            <small class="text-muted">Default access: admin@@hotel.com / Admin@@123</small>
        </div>
    </div>

</body>
</html>