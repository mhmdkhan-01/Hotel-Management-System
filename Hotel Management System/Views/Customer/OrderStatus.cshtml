@model Hotel_Management_System.Models.Order
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Session Status";
    ViewData["HeaderTitle"] = "Active Table Order Summary";

    // 1. Extract raw configuration percentages safely
    decimal cashtaxPercent = ViewBag.cashtax ?? 0;
    decimal cardtaxPercent = ViewBag.cardtax ?? 0;

    // 2. Extract calculated exact financial currency values safely
    decimal cashtaxamount = ViewBag.cashtaxamount ?? 0;
    decimal cardtaxamount = ViewBag.cardtaxamount ?? 0;

    // 🌟 FIX: Extract SubTotal safely using a null-conditional operator (?.)
    // If Model is null, it treats SubTotal as 0 instead of crashing your app!
    decimal currentSubTotal = Model?.SubTotal ?? 0;

    // 3. Compute accurate finalized bill projections using the safe subtotal
    decimal cashbill = currentSubTotal + cashtaxamount;
    decimal cardbill = currentSubTotal + cardtaxamount;
}

<div class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 12px;">
    <h6 class="font-weight-bold mb-3 text-secondary">Current Items Under Assembly</h6>

    @if (!Model.OrderItems.Any(oi => oi.Status != ItemStatus.Cancelled))
    {
        <p class="text-muted text-center py-3 m-0 small">No active orders placed yet. Tap Back below to add some items!</p>
    }
    else
    {
        <div class="d-flex flex-column" style="gap: 15px;">
            @foreach (var item in Model.OrderItems.Where(oi => oi.Status != ItemStatus.Cancelled))
            {
                var uniqueProgressId = "progress_" + item.Id;
                var uniqueCancelBtnId = "cancelBtn_" + item.Id;
                var elapsedSeconds = (DateTime.Now - item.CreatedAt).TotalSeconds;
                var remainingSeconds = 30 - elapsedSeconds;

                <div class="pb-2 border-bottom item-order-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong class="text-dark">@item.Quantity x @item.MenuItem?.Name</strong>
                            @if (!string.IsNullOrEmpty(item.CustomerComment))
                            {
                                <small class="text-muted d-block italic font-xs" style="font-style: italic;">Note: "@item.CustomerComment"</small>
                            }
                            <span class="badge mt-1 font-weight-normal @(item.Status == ItemStatus.Pending ? "bg-warning text-dark" : "bg-light text-secondary border")">
                                Status: @item.Status
                            </span>
                        </div>
                        <span class="text-dark small font-weight-bold">Rs. @(item.Quantity * item.PriceAtOrder)</span>
                    </div>

                    @if (item.Status == ItemStatus.Pending && remainingSeconds > 0)
                    {
                        <div class="progress mt-2" style="height: 6px; background-color: #e9ecef; border-radius: 3px; overflow: hidden;">
                            <div id="@uniqueProgressId" class="progress-bar-slider"
                                 data-created="@item.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")"
                                 style="width: 100%; background-color: var(--accent-pink); height: 100%; transition: none;">
                            </div>
                        </div>

                        <button id="@uniqueCancelBtnId" class="btn btn-sm btn-outline-danger w-100 mt-2 py-1 small cancel-order-btn"
                                onclick="cancelItemImmediately(@item.Id)">
                            Cancel Order (Change Mind)
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px; background: #FFFDFD;">
    <h6 class="font-weight-bold text-secondary mb-3">Automated Statement Summary</h6>

    <div class="d-flex justify-content-between small mb-2">
        <span class="text-muted">Subtotal</span>
        <span class="fw-bold text-dark">Rs. @Model.SubTotal</span>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6">
            <div class="p-2 rounded bg-light border-start border-success" style="border-width: 3px !important;">
                <small class="text-muted d-block font-xs">💵 Cash Tax (@cashtaxPercent%)</small>
                <span class="fw-bold text-success small">Rs. @cashtaxamount</span>
            </div>
        </div>
        <div class="col-6">
            <div class="p-2 rounded bg-light border-start border-primary" style="border-width: 3px !important;">
                <small class="text-muted d-block font-xs">💳 Card Tax (@cardtaxPercent%)</small>
                <span class="fw-bold text-primary small">Rs. @cardtaxamount</span>
            </div>
        </div>
    </div>

    <hr class="my-2 text-muted opacity-25" />

    <div class="d-flex flex-column gap-1 pt-1">
        <div class="d-flex justify-content-between align-items-center">
            <span class="small fw-bold text-secondary">Total (if Cash):</span>
            <span class="h5 m-0 font-weight-bold text-success">Rs. @cashbill</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-1">
            <span class="small fw-bold text-secondary">Total (if Card):</span>
            <span class="h5 m-0 font-weight-bold text-primary">Rs. @cardbill</span>
        </div>
    </div>
</div>

@if (Model.Status == SessionStatus.Active)
{
    <div class="d-flex flex-column gap-2 mb-4">
        <a href="/Customer/Menu" class="btn btn-outline-secondary py-2 font-weight-bold" style="border-radius: 8px;">← Add More Items</a>

        <div class="card border-0 bg-light p-3 mt-2" style="border-radius: 8px;">
            <span class="small font-weight-bold text-dark d-block text-center mb-2">Ready to Finish & Get Bill?</span>
            <div class="row g-2">
                <div class="col-6">
                    <form asp-action="CompleteSession" method="post">
                        <input type="hidden" name="method" value="Cash" />
                        <button type="submit" class="btn btn-success w-100 py-2 small fw-bold" style="border-radius: 8px;">💵 Pay via Cash</button>
                    </form>
                </div>
                <div class="col-6">
                    <form asp-action="CompleteSession" method="post">
                        <input type="hidden" name="method" value="Card" />
                        <button type="submit" class="btn btn-primary w-100 py-2 small fw-bold" style="border-radius: 8px;">💳 Pay via Card</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success text-center py-3" style="border-radius: 12px;">
        🎉 <strong>Receipt sent to Counter!</strong><br />
        <span class="small">Payment selection: <strong>@Model.PreferredPayment</strong>. Your waiter is arriving shortly. Thank you!</span>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const progressBars = document.querySelectorAll('.progress-bar-slider');

            progressBars.forEach(bar => {
                const createdTimeStr = bar.getAttribute('data-created');
                const safeDateStr = createdTimeStr.replace(/-/g, '/').replace('T', ' ');
                const createdTime = new Date(safeDateStr).getTime();

                const totalDuration = 30 * 1000;
                const endTime = createdTime + totalDuration;

                function updateProgress() {
                    const now = new Date().getTime();
                    const remainingTime = endTime - now;

                    if (isNaN(remainingTime)) {
                        bar.style.width = "0%";
                        return;
                    }

                    if (remainingTime <= 0) {
                        bar.style.width = "0%";

                        const itemId = bar.id.replace('progress_', '');
                        const baseUrl = window.location.origin;
                        const requestUrl = `${baseUrl}/Customer/CommitItemToKitchen?orderItemId=${itemId}`;

                        fetch(requestUrl, {
                            method: 'POST'
                        })
                        .then(response => response.json())
                        .then(data => {
                            if(data.success) {
                                location.reload();
                            }
                        })
                        .catch(err => {
                            console.error("Auto-commit failed:", err);
                            location.reload();
                        });

                        const itemCard = bar.closest('.item-order-card');
                        if (itemCard) {
                            const cancelBtn = itemCard.querySelector('.cancel-order-btn');
                            if (cancelBtn) cancelBtn.remove();

                            const progressContainer = bar.parentElement;
                            if (progressContainer) progressContainer.remove();
                        }
                        return;
                    }

                    const percentage = (remainingTime / totalDuration) * 100;
                    bar.style.width = percentage + "%";

                    requestAnimationFrame(updateProgress);
                }

                updateProgress();
            });

            if(progressBars.length > 0) {
                setTimeout(function() {
                    location.reload();
                }, 31000);
            }
        });

        function cancelItemImmediately(id) {
             const baseUrl = window.location.origin;
            if(confirm("Are you sure you want to cancel this item?")) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = `${baseUrl}/Customer/CancelItem?orderItemId=` + id;
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}