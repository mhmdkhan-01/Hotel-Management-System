@model Hotel_Management_System.Models.Order
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Session Status";
    ViewData["HeaderTitle"] = "Active Table Order Summary";

    // 1. Extract raw configuration percentages safely
    decimal cashtaxPercent = ViewBag.cashtax ?? 0;
    decimal cardtaxPercent = ViewBag.cardtax ?? 0;

    // 2. Extract calculated exact financial currency values safely
    decimal cashtaxamount = ViewBag.cashtaxamount ?? 0;
    decimal cardtaxamount = ViewBag.cardtaxamount ?? 0;

    // Extract SubTotal safely using a null-conditional operator (?.)
    decimal currentSubTotal = Model?.SubTotal ?? 0;

    // 3. Compute accurate finalized bill projections using the safe subtotal
    decimal cashbill = currentSubTotal + cashtaxamount;
    decimal cardbill = currentSubTotal + cardtaxamount;
}

<div class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 12px;">
    <h6 class="font-weight-bold mb-3 text-secondary">Current Items Under Assembly</h6>

    @if (!Model.OrderItems.Any(oi => oi.Status != ItemStatus.Cancelled))
    {
        <p class="text-muted text-center py-3 m-0 small">No active orders placed yet. Tap Back below to add some items!</p>
    }
    else
    {
        <div class="d-flex flex-column" style="gap: 15px;">
            @foreach (var item in Model.OrderItems.Where(oi => oi.Status != ItemStatus.Cancelled))
            {
                <div class="pb-2 border-bottom item-order-card" id="item-card-@item.Id">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong class="text-dark">@item.Quantity x @item.MenuItem?.Name</strong>
                            @if (!string.IsNullOrEmpty(item.CustomerComment))
                            {
                                <small class="text-muted d-block italic font-xs" style="font-style: italic;">Note: "@item.CustomerComment"</small>
                            }
                            <span id="badge-status-@item.Id" class="badge mt-1 font-weight-normal @(item.Status == ItemStatus.Pending ? "bg-warning text-dark" : "bg-light text-secondary border")">
                                Status: @item.Status
                            </span>
                        </div>
                        <span class="text-dark small font-weight-bold">Rs. @((item.Quantity * item.PriceAtOrder).ToString("F2"))</span>
                    </div>

                    @if (item.Status == ItemStatus.Pending)
                    {
                        <div class="d-flex gap-2 mt-2" id="actions-container-@item.Id">
                            <button class="btn btn-sm btn-success flex-grow-1 py-1.5 small fw-bold"
                                    onclick="confirmItemImmediately(@item.Id)">
                                🎯 Confirm Order
                            </button>
                            <button class="btn btn-sm btn-outline-danger py-1.5 small"
                                    onclick="cancelItemImmediately(@item.Id)">
                                Cancel
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px; background: #FFFDFD;">
    <h6 class="font-weight-bold text-secondary mb-3">Automated Statement Summary</h6>

    <div class="d-flex justify-content-between small mb-2">
        <span class="text-muted">Subtotal</span>
        <span class="fw-bold text-dark">Rs. @currentSubTotal.ToString("F2")</span>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6">
            <div class="p-2 rounded bg-light border-start border-success" style="border-width: 3px !important;">
                <small class="text-muted d-block font-xs">💵 Cash Tax (@cashtaxPercent.ToString("F2")%)</small>
                <span class="fw-bold text-success small">Rs. @cashtaxamount.ToString("F2")</span>
            </div>
        </div>
        <div class="col-6">
            <div class="p-2 rounded bg-light border-start border-primary" style="border-width: 3px !important;">
                <small class="text-muted d-block font-xs">💳 Card Tax (@cardtaxPercent.ToString("F2")%)</small>
                <span class="fw-bold text-primary small">Rs. @cardtaxamount.ToString("F2")</span>
            </div>
        </div>
    </div>

    <hr class="my-2 text-muted opacity-25" />

    <div class="d-flex flex-column gap-1 pt-1">
        <div class="d-flex justify-content-between align-items-center">
            <span class="small fw-bold text-secondary">Total (if Cash):</span>
            <span class="h5 m-0 font-weight-bold text-success">Rs. @cashbill.ToString("F2")</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-1">
            <span class="small fw-bold text-secondary">Total (if Card):</span>
            <span class="h5 m-0 font-weight-bold text-primary">Rs. @cardbill.ToString("F2")</span>
        </div>
    </div>
</div>

@if (Model.Status == SessionStatus.Active)
{
    <div class="d-flex flex-column gap-2 mb-4">
        <a href="/Customer/Menu" class="btn btn-outline-secondary py-2 font-weight-bold" style="border-radius: 8px;">← Add More Items</a>

        <div class="card border-0 bg-light p-3 mt-2" style="border-radius: 8px;">
            <span class="small font-weight-bold text-dark d-block text-center mb-2">Ready to Finish & Get Bill?</span>
            <div class="row g-2">
                <div class="col-6">
                    <form asp-action="CompleteSession" method="post">
                        <input type="hidden" name="method" value="Cash" />
                        <button type="submit" class="btn btn-success w-100 py-2 small fw-bold" style="border-radius: 8px;">💵 Pay via Cash</button>
                    </form>
                </div>
                <div class="col-6">
                    <form asp-action="CompleteSession" method="post">
                        <input type="hidden" name="method" value="Card" />
                        <button type="submit" class="btn btn-primary w-100 py-2 small fw-bold" style="border-radius: 8px;">💳 Pay via Card</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success text-center py-3" style="border-radius: 12px;">
        🎉 <strong>Receipt sent to Counter!</strong><br />
        <span class="small">Payment selection: <strong>@Model.PreferredPayment</strong>. Your waiter is arriving shortly. Thank you!</span>
    </div>
    <div class="text-center mb-4">
        <a href="#" class="text-decoration-none fw-bold small text-primary d-inline-flex align-items-center gap-1" onclick="toggleReceipt(event)">
            📄 View Digital Receipt
        </a>
    </div>

    <div id="digital-receipt" class="d-none card border shadow-sm p-4 mb-4 mx-auto" style="border-radius: 4px; max-width: 360px; background: #fff; font-family: 'Courier New', Courier, monospace; color: #222; border: 1px dashed #ccc !important;">

        <div class="text-center mb-3">
            <h4 class="fw-bold m-0 text-uppercase tracking-wide">@ViewBag.RestaurantName</h4>
            <small class="text-muted d-block mt-1">Digital Bill Summary</small>
            <div class="text-muted font-xs mt-1" style="font-size: 0.75rem;">
                @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
            </div>
        </div>

        <div style="border-top: 1px dashed #444;" class="my-2"></div>

        <div class="d-flex justify-content-between small mb-2">
            <span><strong>Table:</strong> @Model.Table?.TableNumber</span>
            <span><strong>Session:</strong> #@Model.Id</span>
        </div>

        <div style="border-top: 1px dashed #ccc;" class="my-2"></div>

        <div class="d-flex justify-content-between font-weight-bold small mb-1 text-muted">
            <span style="flex: 2;">Item</span>
            <span style="flex: 1;" class="text-center">Qty</span>
            <span style="flex: 1;" class="text-end">Price</span>
        </div>

        @{
            var groupedItems = Model.OrderItems
                .Where(oi => oi.Status != ItemStatus.Cancelled)
                .GroupBy(oi => new { oi.MenuItem?.Name, oi.PriceAtOrder })
                .Select(g => new
                {
                    Name = g.Key.Name ?? "Unknown Item",
                    UnitPrice = g.Key.PriceAtOrder,
                    TotalQuantity = g.Sum(oi => oi.Quantity),
                    TotalRowPrice = g.Sum(oi => oi.Quantity * oi.PriceAtOrder)
                });
        }

        <div class="d-flex flex-column gap-1">
            @foreach (var group in groupedItems)
            {
                <div class="d-flex justify-content-between align-items-start small" style="font-size: 0.85rem;">
                    <span style="flex: 2;" class="text-truncate pr-1">@group.Name</span>
                    <span style="flex: 1;" class="text-center">@group.TotalQuantity</span>
                    <span style="flex: 1;" class="text-end">Rs. @group.TotalRowPrice.ToString("F2")</span>
                </div>
            }
        </div>

        <div style="border-top: 1px dashed #444;" class="my-3"></div>

        @{
            bool isCard = Model.PreferredPayment == PaymentMethod.Card;
            decimal activeTaxAmt = isCard ? cardtaxamount : cashtaxamount;
            decimal activeTaxPct = isCard ? cardtaxPercent : cashtaxPercent;
            decimal finalBillAmt = currentSubTotal + activeTaxAmt;
        }

        <div class="d-flex flex-column gap-1 small">
            <div class="d-flex justify-content-between">
                <span>Subtotal:</span>
                <span>Rs. @currentSubTotal.ToString("F2")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Tax (@activeTaxPct%):</span>
                <span>Rs. @activeTaxAmt.ToString("F2")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Payment Mode:</span>
                <span class="fw-bold text-uppercase">@Model.PreferredPayment</span>
            </div>

            <div style="border-top: 1px dashed #ccc;" class="my-2"></div>

            <div class="d-flex justify-content-between font-weight-bold text-dark" style="font-size: 1.05rem;">
                <span>TOTAL PAID:</span>
                <span>Rs. @finalBillAmt.ToString("F2")</span>
            </div>
        </div>

        <div style="border-top: 1px dashed #444;" class="my-3"></div>

        <div class="text-center mt-2">
            <p class="m-0 fw-bold small text-uppercase tracking-wider">Thank You For Dining With Us!</p>
            <small class="text-muted" style="font-size:0.7rem;">Please visit us again.</small>
        </div>
    </div>
}

@section Scripts {
    <script>
        // 🚀 Triggers immediate user-driven manual kitchen synchronization
        function confirmItemImmediately(itemId) {
            const baseUrl = window.location.origin;
            const requestUrl = `${baseUrl}/Customer/CommitItemToKitchen?orderItemId=${itemId}`;

            // Lock panel interface from accepting multi-clicks during connection load
            const container = document.getElementById(`actions-container-${itemId}`);
            if (container) container.style.pointerEvents = 'none';

            fetch(requestUrl, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert("Could not confirm item. Please try again.");
                    if (container) container.style.pointerEvents = 'auto';
                }
            })
            .catch(err => {
                console.error("Manual commit error:", err);
                location.reload();
            });
        }

        function cancelItemImmediately(id) {
            const baseUrl = window.location.origin;
            if(confirm("Are you sure you want to cancel this item?")) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = `${baseUrl}/Customer/CancelItem?orderItemId=` + id;
                document.body.appendChild(form);
                form.submit();
            }
        }

        function toggleReceipt(event) {
            event.preventDefault();
            const receipt = document.getElementById("digital-receipt");
            if (receipt.classList.contains("d-none")) {
                receipt.classList.remove("d-none");
                receipt.scrollIntoView({ behavior: 'smooth' });
            } else {
                receipt.classList.add("d-none");
            }
        }
    </script>
}