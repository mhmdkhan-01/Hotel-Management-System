@model IEnumerable<Hotel_Management_System.Models.MenuItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Menu Items";
    var categories = ViewBag.Categories as List<Hotel_Management_System.Models.Category> ?? new List<Hotel_Management_System.Models.Category>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="font-weight-bold m-0">🍔 Menu Catalog Management</h2>
        <small class="text-muted">Control prices, visibility, and add new dishes to the digital menu instantly.</small>
    </div>
    <button class="btn btn-pink py-2 px-4" data-bs-toggle="modal" data-bs-target="#addItemModal">
        + Add New Menu Item
    </button>
</div>

<div class="card border-0 shadow-sm p-4" style="border-radius: 12px; background: white;">
    <div class="table-responsive">
        <table class="table table-hover align-middle m-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Image</th>
                    <th>Dish Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No menu items found. click the button above to add one!</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;" onerror="this.src='/images/default-food.png'" />
                        </td>
                        <td>
                            <strong class="text-dark d-block">@item.Name</strong>
                            <small class="text-muted d-block text-truncate" style="max-width: 250px;">@item.Description</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.Category?.Name</span></td>
                        <td class="fw-bold">Rs. @item.Price</td>
                        <td>
                            <span class="badge @(item.IsAvailable ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                @(item.IsAvailable ? "Active on Menu" : "Hidden / Sold Out")
                            </span>
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleAvailability" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-danger" : "btn-outline-success") py-1 px-3">
                                    @(item.IsAvailable ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Create Item Entry Modal Box -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">Create New Dish</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Added enctype attribute here for processing local file uploads -->
            <form asp-action="CreateItem" method="post" enctype="multipart/form-data">
                <div class="modal-body small">

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary">DISH NAME</label>
                        <input name="Name" class="form-control" placeholder="e.g., Grilled Chicken Burger" required />
                    </div>

                    <!-- Category Panel Field with Dual Modes -->
                    <div class="form-group mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold text-secondary m-0">CATEGORY</label>
                            <button type="button" id="toggleCategoryBtn" class="btn btn-link font-xs p-0 text-decoration-none" style="color: var(--primary-pink);">
                                ➕ Add New Category
                            </button>
                        </div>

                        <!-- Choice 1: Existing Category Picker Dropdown Selection -->
                        <div id="existingCategoryWrapper">
                            <select id="categorySelect" name="CategoryId" class="form-select" required>
                                <option value="">-- Choose Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Choice 2: Custom Brand New Category Inline Input Creator -->
                        <div id="newCategoryWrapper" class="d-none">
                            <input id="newCategoryInput" name="NewCategoryName" class="form-control" placeholder="Type new category name (e.g., Drinks)" />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary">PRICE (Rs.)</label>
                        <input type="number" name="Price" class="form-control" placeholder="e.g., 550" min="0" step="0.01" required />
                    </div>

                    <!-- Upgraded Local Device Image Picker Input Element Box -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary">SELECT DISH IMAGE (FROM DEVICE)</label>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                        <small class="text-muted font-xs d-block mt-1">Acceptable formats: PNG, JPG, JPEG, WEBP.</small>
                    </div>

                    <div class="form-group mb-2">
                        <label class="form-label fw-bold text-secondary">DESCRIPTION / INGREDIENTS</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Briefly detail the dish parameters..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-pink w-100 py-2">Save to Catalog</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript Component Handler Configuration -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("toggleCategoryBtn");
        const existingWrapper = document.getElementById("existingCategoryWrapper");
        const newWrapper = document.getElementById("newCategoryWrapper");
        const categorySelect = document.getElementById("categorySelect");
        const newCategoryInput = document.getElementById("newCategoryInput");

        toggleBtn.addEventListener("click", function () {
            if (newWrapper.classList.contains("d-none")) {
                // Switch mode display fields to accept custom type input data
                newWrapper.classList.remove("d-none");
                existingWrapper.classList.add("d-none");
                toggleBtn.innerText = "↩️ Choose Existing Category";

                // Toggle required attributes so form submission works flawlessly
                categorySelect.removeAttribute("required");
                newCategoryInput.setAttribute("required", "required");
                categorySelect.value = "";
            } else {
                // Return fallback state mode components
                newWrapper.classList.add("d-none");
                existingWrapper.classList.remove("d-none");
                toggleBtn.innerText = "➕ Add New Category";

                newCategoryInput.removeAttribute("required");
                categorySelect.setAttribute("required", "required");
                newCategoryInput.value = "";
            }
        });
    });
</script>